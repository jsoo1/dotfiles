:m + Prelude
:set prompt "%s \x03BB "

let abbr cmd arg = return $ ":! " ++ cmd ++ " " ++ arg

-- emacsclient
:def! em (abbr "TERM=xterm-24bits emacsclient -nw --socket-name term")

-- vim
:def! vim (abbr "vim")

-- standards
:def! pwd (abbr "pwd")
:def! lsa (abbr "ls -lsa")
:def! ls (abbr "ls")
:def! clear (abbr "clear")
:def! ssh (abbr "ssh")
